{
  "name": "camille",
  "private": true,
  "packageManager": "pnpm@11.28.2",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "preinstall": "node scripts/so-pnpm.cjs",
    "dev:api": "turbo run dev --filter=@camille/api",
    "dev:mobile": "turbo run build --filter=@camille/shared && pnpm --filter @camille/mobile start",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "build:web": "turbo run build --filter=@camille/shared && pnpm --filter @camille/mobile exec expo export --platform web --clear"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.13.0",
    "prettier": "^3.9.10",
    "turbo": "^2.11.7",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.71.2"
  }
}
