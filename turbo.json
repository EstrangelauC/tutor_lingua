{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"]
    },
    "typecheck": {
      "dependsOn": ["^build"]
    },
    "lint": {},
    "test": {
      "dependsOn": ["^build"]
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
      "passThroughEnv": [
        "PORT",
        "NODE_ENV",
        "ANTHROPIC_API_KEY",
        "ANTHROPIC_MODEL",
        "OPENAI_API_KEY",
        "OPENAI_TRANSCRIPTION_MODEL",
        "CAMILLE_API_KEY",
        "CONFIANCE_PROXY",
        "LIMITE_SESSIONS_PAR_HEURE",
        "LIMITE_REQUETES_PAR_MINUTE",
        "CORS_ORIGINES"
      ]
    }
  }
}
