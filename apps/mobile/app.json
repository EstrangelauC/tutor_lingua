{
  "expo": {
    "name": "Camille",
    "slug": "camille",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "camille",
    "userInterfaceStyle": "automatic",
    "ios": {
      "bundleIdentifier": "com.estrangelauc.camille",
      "supportsTablet": false,
      "infoPlist": {
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "package": "com.estrangelauc.camille",
      "adaptiveIcon": {
        "backgroundColor": "#2747C4",
        "foregroundImage": "./assets/images/android-icon-foreground.png",
        "backgroundImage": "./assets/images/android-icon-background.png",
        "monochromeImage": "./assets/images/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "output": "static",
      "favicon": "./assets/images/favicon.png"
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "backgroundColor": "#2747C4",
          "image": "./assets/images/splash-icon.png",
          "imageWidth": 120,
          "dark": {
            "backgroundColor": "#0E1222"
          }
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "A Camille precisa do microfone para ouvir as tuas respostas em francês."
        }
      ],
      [
        "expo-localization",
        {
          "supportsRTL": false
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true,
      "reactCompiler": true
    }
  }
}
