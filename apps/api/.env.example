# Porta HTTP da API
PORT=3000

# development | test | production
NODE_ENV=development

# Chave da API da Anthropic. Sem chave, a API usa uma Camille simulada
# (respostas fixas, sem custos). Obrigatória com NODE_ENV=production.
ANTHROPIC_API_KEY=

# Modelo usado pela Camille (opcional; por omissão claude-opus-5-5).
ANTHROPIC_MODEL=

# Chave da API da OpenAI, usada só para transcrever a voz do aluno. Sem chave, a API
# usa uma transcrição simulada (frases fixas). Obrigatória com NODE_ENV=production.
OPENAI_API_KEY=

# Modelo de transcrição (opcional; por omissão gpt-4o-transcribe).
OPENAI_TRANSCRIPTION_MODEL=

# Chave que a app tem de enviar em cada pedido (Authorization: Bearer …); inventa uma com
# pelo menos 16 caracteres (por exemplo `openssl rand -hex 24`) e põe a mesma em
# EXPO_PUBLIC_CAMILLE_API_KEY na app. Sem chave, a API aceita qualquer pedido: só em
# desenvolvimento. Obrigatória com NODE_ENV=production.
CAMILLE_API_KEY=

# true quando a API corre atrás de um proxy (Render, Fly, nginx…), para os limites por IP
# usarem o X-Forwarded-For.
CONFIANCE_PROXY=false

# Limites por IP (opcionais): sessões criadas por hora e pedidos por minuto.
LIMITE_SESSIONS_PAR_HEURE=20
LIMITE_REQUETES_PAR_MINUTE=60

# Origens autorizadas para a versão web da app, separadas por vírgulas (por exemplo
# https://camille.exemplo.pt). Em desenvolvimento não é preciso: aceita-se qualquer origem.
CORS_ORIGINES=
