# Porta HTTP da API
PORT=3000

# development | test | production
NODE_ENV=development

# Chave da API da Anthropic. Sem chave, a API usa uma Camille simulada
# (respostas fixas, sem custos). Obrigatória com NODE_ENV=production.
ANTHROPIC_API_KEY=

# Modelo usado pela Camille (opcional; por omissão claude-opus-5-5).
ANTHROPIC_MODEL=
